[Unit]
Description=sub2api-auto5h quota window activator
Documentation=https://github.com/MengStar-L/sub2api-auto5h
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=sub2api-auto5h
Group=sub2api-auto5h
# SUB2API_AUTO5H_INSTALL_DIR=/opt/sub2apiauto5h
EnvironmentFile=/opt/sub2apiauto5h/config/sub2api-auto5h.env
ExecStart=/opt/sub2apiauto5h/sub2api-auto5h serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
ReadWritePaths=/opt/sub2apiauto5h/data /opt/sub2apiauto5h/backups
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
